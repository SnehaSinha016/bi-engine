# Only needed when frontend and backend are deployed as two separate
# services (e.g. Vercel for the frontend + Render/Railway/Fly.io for
# the backend). Leave unset for local dev — Vite's dev-server proxy
# in vite.config.js handles /api -> localhost:4000 automatically.
# VITE_API_BASE_URL=https://your-backend-host.example.com/api
