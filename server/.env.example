# Copy this file to server/.env and fill in what you're using — the
# server loads it automatically via dotenv on startup.

# ------------------------------------------------------------------
# SECURITY (required) — P7: no hardcoded fallback. The server
# refuses to boot without this set.
# ------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string

# ------------------------------------------------------------------
# DATA SOURCE — controls where server/data/sources/index.js pulls
# ERP/CRM/Support data from. Default: synthetic (no config needed).
# ------------------------------------------------------------------
# One of: synthetic | csv | shopify | zendesk | blended
DATA_SOURCE=synthetic

# --- csv mode: reads server/data/csv/*.csv (see README §CSV export) ---
# No env vars needed — just make sure the CSVs exist.

# --- shopify mode (or blended): real orders/revenue/discounts/refunds ---
SHOPIFY_SHOP=your-store-name
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- zendesk mode (or blended): real support tickets ---
ZENDESK_SUBDOMAIN=yourcompany
ZENDESK_EMAIL=you@yourcompany.com
ZENDESK_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- salesforce (only used in blended mode, for churn signal) ---
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SF_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SF_USERNAME=integration-user@yourcompany.com
SF_PASSWORD=yourPasswordPlusSecurityToken

# ------------------------------------------------------------------
# LLM — narration only, never calculation (see README). Omit BOTH
# GEMINI_API_KEY and ANTHROPIC_API_KEY to use the deterministic mock
# provider (no key needed). If both are set, GEMINI_API_KEY wins —
# Gemini has a genuine no-credit-card free tier, making it the
# easiest real LLM to actually try. Get a free key at
# https://aistudio.google.com/apikey
# ------------------------------------------------------------------
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_INPUT_PRICE_PER_MILLION=0
# GEMINI_OUTPUT_PRICE_PER_MILLION=0

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=claude-sonnet-4-6

# P8: pricing is config, not hardcoded in application logic. These
# only affect the *estimated* cost shown in Telemetry — set them to
# match your actual contracted rate.
LLM_INPUT_PRICE_PER_MILLION=3
LLM_OUTPUT_PRICE_PER_MILLION=15

# ------------------------------------------------------------------
# P1 — ADAPTIVE MATERIALITY
# Multiplier applied to a metric's own trailing coefficient of
# variation to derive its adaptive materiality threshold. Higher =
# more tolerant of noisy metrics before flagging them material.
# Per-KPI `materialityFloor` (a minimum floor, not the threshold
# itself) lives in shared/kpiContracts.js.
# ------------------------------------------------------------------
MATERIALITY_ADAPTIVE_MULTIPLIER=1.6

# ------------------------------------------------------------------
# P5 — CONFIDENCE MODEL WEIGHTS
# Must sum to ~1.0 across the five weighted components (temporal
# alignment is folded in as its own weight). Defaults match the
# original hand-tuned values — override once real outcome data
# (via the feedback loop) suggests better weights.
# ------------------------------------------------------------------
CONFIDENCE_WEIGHT_CONTRIBUTION=0.25
CONFIDENCE_WEIGHT_ANOMALY=0.2
CONFIDENCE_WEIGHT_EVIDENCE=0.2
CONFIDENCE_WEIGHT_HISTORICAL=0.15
CONFIDENCE_WEIGHT_DATA_QUALITY=0.1
CONFIDENCE_WEIGHT_TEMPORAL=0.1
CONFIDENCE_CONTRADICTION_PENALTY=6
CONFIDENCE_TIER_HIGH=75
CONFIDENCE_TIER_MEDIUM=50

# ------------------------------------------------------------------
PORT=4000
